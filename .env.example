# NEXTGEN SOC ENVIRONMENT CONFIGURATION

# Neon PostgreSQL Database Connection URL
DATABASE_URL="postgresql://neondb_owner:npg_sample@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Auth.js / NextAuth Configuration
NEXTAUTH_SECRET="nextgen_soc_super_secure_auth_secret_production_key_32_bytes_min"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Vercel Blob Storage Token (for payment screenshot uploads)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_sample_token"

# Google Cloud Vision OCR (API Key or Service Account credentials)
GOOGLE_VISION_API_KEY="your-google-cloud-vision-api-key"

# Master Admin Email (automatically assigned 'admin' role on login)
ADMIN_EMAILS="admin@nextgensoc.io,soc-lead@nextgensoc.io"
